PORT=3000
DB_PATH=./data/estudos.db
PDF_ROOT=./public/pdfs
GEMINI_API_KEY=your_api_key_here
NODE_ENV=development

# Google OAuth (obrigatório para login)
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

# Sessão Express (string longa e aleatória)
SESSION_SECRET=gere_uma_string_longa_e_aleatoria_aqui

# E-mails autorizados a fazer login (separados por vírgula)
# Deixe vazio para permitir qualquer conta Google autenticada
ALLOWED_EMAILS=seu@email.com
